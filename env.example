# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real keys or paths that reveal your username.
#
# Format Docker Compose will accept:
#   NAME=value
#   # comments and blank lines are fine
# A label on its own line ("API CREDENTIALS", "Token value") is not. Compose
# stops at the first one and ignores every key below it.
# No spaces around =. No quotes. No "export". Do not use ~ in a path.

# --- Docker volume host paths ---
# Docker Compose does NOT reliably expand ~ (and not at all on Windows), so
# these must be absolute paths set per-machine.
#
# macOS example:
#   HOST_HERMES_DIR=/Users/yourname/.hermes
#   HOST_SSH_DIR=/Users/yourname/.ssh
#
# Linux example (Omarchy and other distros — Docker runs natively, no VM layer):
#   HOST_HERMES_DIR=/home/yourname/.hermes
#   HOST_SSH_DIR=/home/yourname/.ssh
#
# Windows example (Docker Desktop, WSL2 backend) — use the Windows path,
# Docker Desktop translates it for the Linux containers:
#   HOST_HERMES_DIR=C:\Users\yourname\.hermes
#   HOST_SSH_DIR=C:\Users\yourname\.ssh
HOST_HERMES_DIR=
HOST_SSH_DIR=

# --- Keys the desktop app reads (npm run tauri-dev only) ---
# A plain browser tab cannot see this file.
# Anthropic's value is used by the `Anthropic (API key)` chat provider and by
# the claude-agent container. Claude Subscription DirectSDK does NOT use it --
# that path runs the `claude` CLI on its own login and strips this variable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
# Leave empty unless you have an xAI key. The Grok container needs this.
# Chat can still reach Grok models through Nous Portal without it.
XAI_API_KEY=

# --- Present for Hermes / other tools. This app does not call them yet. ---
# Nous chat uses the local Hermes proxy, not NOUS_API_KEY.
NOUS_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# --- Vault relay push (optional, untested against this repo) ---
VAULT_REPO=

# --- Google sign-in (profile identity only; nothing syncs) ---
# OAuth client id for an application type of "Desktop app".
# PUBLIC BY DESIGN: a desktop client cannot keep a secret, so this value ships
# inside the binary and PKCE is what protects the token exchange. It lives here
# only so a different machine can use a different client without a code change.
# Do NOT add the client secret -- this app never sends one.
VITE_GOOGLE_CLIENT_ID=

# Client secret for that SAME OAuth client. Required despite PKCE: Google's
# "Desktop app" client type still demands client_secret at the token endpoint,
# and answers 400 invalid_client without it. It is a low-value secret by
# Google's own model (it ships inside every installed copy of the app), but it
# is read by the Rust process and deliberately NOT given a VITE_ prefix, so it
# never gets inlined into the JS bundle.
GOOGLE_CLIENT_SECRET=
