# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real keys or paths that reveal your username.

# --- Docker volume host paths ---
# Docker Compose does NOT reliably expand ~ (and not at all on Windows), so
# these must be absolute paths set per-machine.
#
# macOS example:
#   HOST_HERMES_DIR=/Users/yourname/.hermes
#   HOST_SSH_DIR=/Users/yourname/.ssh
#
# Linux example (Omarchy and other distros — Docker runs natively, no VM layer):
#   HOST_HERMES_DIR=/home/yourname/.hermes
#   HOST_SSH_DIR=/home/yourname/.ssh
#
# Windows example (Docker Desktop, WSL2 backend) — use the Windows path,
# Docker Desktop translates it for the Linux containers:
#   HOST_HERMES_DIR=C:\Users\yourname\.hermes
#   HOST_SSH_DIR=C:\Users\yourname\.ssh
HOST_HERMES_DIR=
HOST_SSH_DIR=

# --- Provider API keys (only needed for agents/providers you actually use) ---
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
NOUS_API_KEY=

# --- Vault sync (optional) ---
VAULT_REPO=
