# package-lock.json is tracked deliberately — a fresh `npm install` from a
# clone needs it for reproducible installs. pnpm-lock.yaml stays ignored
# since this project uses npm, not pnpm; if that ever changes, track the
# one lockfile that matches the package manager actually in use, not both.
pnpm-lock.yaml
*.log
vault/.git
vault/AGENT_OUTBOX_*.md
.vault-cache/
.hermes/
# Per-machine agent enable/model toggles -- personal runtime state, not
# project config. agent_status() (main.rs) treats a missing file as "all
# disabled" rather than erroring, so this is safe to omit entirely; new
# clones copy agents-config.json.example to get started.
vault/agents-config.json
